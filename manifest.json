{
  "manifest_version": 3,
  "name": "TabVault",
  "version": "0.2.0",
  "minimum_chrome_version": "116",
  "description": "Local-first browser tab recording for SharePoint, Teams, and generic tabs.",
  "permissions": [
    "activeTab",
    "storage",
    "tabCapture",
    "offscreen"
  ],
  "action": {
    "default_title": "TabVault",
    "default_popup": "src/popup/popup.html"
  },
  "background": {
    "service_worker": "src/background/service-worker.js",
    "type": "module"
  }
}
